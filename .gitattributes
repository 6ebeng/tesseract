# Normalize text files to LF in repo, but let .ps1 keep CRLF on checkout via .editorconfig
* text=auto eol=lf

# PowerShell scripts - allow CRLF locally; Git still stores LF
*.ps1 text eol=crlf

# Treat common binary types as binary
*.ttf binary
*.tif binary
*.traineddata binary
*.png binary
*.jpg binary

# Generated artifacts should not cause diffs
work/training_output/** -diff
work/training_output/** -merge
# Normalize line endings and mark binary assets

# Scripts (used in WSL) should be LF
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.txt text eol=lf

# PowerShell on Windows prefers CRLF
*.ps1 text eol=crlf

# Fonts and trained models are binary
*.ttf binary
*.otf binary
*.traineddata binary
*.lstm binary
*.lstmf binary
*.tif binary
*.box text eol=lf

# Word docs and archives as binary
*.docx binary
*.zip binary
*.7z binary
*.rar binary
*.tar.gz binary

# Prevent automatic line ending conversions for these files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary