root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{md,markdown}]
end_of_line = lf
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{conf,config,properties}]
end_of_line = lf
indent_style = space
indent_size = 2root = true

# Default settings
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Shell/Python/Docs use LF for WSL compatibility
[*.sh]
end_of_line = lf

[*.py]
end_of_line = lf

[*.{md,json,conf,txt}]
end_of_line = lf

# PowerShell on Windows
[*.ps1]
end_of_line = crlf
